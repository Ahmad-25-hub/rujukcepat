# Salin ke .env.local. Isi placeholder secara lokal; jangan commit kredensial.
# Konfigurasi awal memakai data lokal dan skenario contoh tanpa layanan AI/rute eksternal.

# --- Aplikasi ---
NEXT_PUBLIC_APP_ENV=development
DATA_MODE=local
LOCAL_DB_DIR=.data/pglite
# Isi dengan string acak panjang untuk menandatangani cookie sesi.
SESSION_SECRET=<string-acak-panjang>
# Kata sandi akun petugas bawaan; akun impor memiliki kata sandi tersendiri.
DEMO_STAFF_PASSWORD=<kata-sandi-petugas>

# --- AI: live = Gemini; mock = keluaran dari fixture sintetis ---
AI_MODE=mock
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=20000
# LOW | MEDIUM | HIGH
GEMINI_THINKING_LEVEL=LOW

# --- Rute: live = OSRM; mock = perkiraan dari jarak garis lurus ---
ROUTING_MODE=mock
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=4000
MATCH_MAX_ROUTED=5
# Radius pencarian berdasarkan jarak garis lurus, dalam kilometer.
MATCH_MAX_KM=100
# Batas usia status fasilitas, dalam menit. Nilai ini untuk demonstrasi prototipe.
STALE_AFTER_MINUTES=43200

# --- Supabase: diperlukan jika DATA_MODE=supabase ---
# Konfigurasi publik untuk koneksi Realtime; bukan kredensial PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Alternatif proyek dengan key lama:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Kredensial berikut hanya untuk server.
SUPABASE_SECRET_KEY=<secret-key>
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_DB_URL=<postgres-connection-string>
# Opsional: CA PostgreSQL; tulis pemisah baris sebagai \n.
# SUPABASE_DB_CA_CERT=<sertifikat-CA>

# --- Pembatas laju per klien, per instans server ---
# ANALYZE_RATE_PER_MINUTE=12
# LOGIN_RATE_PER_MINUTE=10
