# Salin ke .env.local lalu isi. Jangan commit .env.local.

# --- Publik (aman di klien; dibatasi RLS saat memakai Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Alternatif proyek lama, bila tidak memakai publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# development | preview | production
NEXT_PUBLIC_APP_ENV=development

# --- Hanya server ---
# Sumber data fasilitas/rujukan:
#   local    = PGlite (Postgres WASM) di LOCAL_DB_DIR, migrasi + seed otomatis (data SIMULASI lokal)
#   supabase = Supabase PostgreSQL lewat SUPABASE_DB_URL (SQL yang sama); sinkronisasi lewat Supabase Realtime (broadcast)
DATA_MODE=local
LOCAL_DB_DIR=.data/pglite
SUPABASE_SECRET_KEY=<secret-key>
# Alternatif proyek lama: SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Connection string Postgres dari tombol Connect > Session/Transaction pooler.
# Isi password database pada connection string (bukan API key). Hanya untuk server.
SUPABASE_DB_URL=<postgres-connection-string>
# Opsional: CA dari Database Settings, dengan baris baru ditulis sebagai \n.
# SUPABASE_DB_CA_CERT=<sertifikat-CA>

# Penanda tangan cookie sesi (wajib di produksi). Buat acak, mis. `openssl rand -hex 32`.
SESSION_SECRET=<string-acak-panjang>
# Kata sandi SEMUA akun petugas demo (rscm@, fatmawati@, tarakan@, pasarminggu@, pon@, admin@ rujukcepat.demo).
# Tidak disimpan di repo; tanpa ini login petugas dinonaktifkan.
DEMO_STAFF_PASSWORD=<kata-sandi-demo>

GEMINI_API_KEY=<gemini-api-key>
# gemini-2.5-flash (kandidat proposal) ditolak untuk pengguna baru (404); 3.8/3.7-flash timeout saat diuji 31-10-2026.
# Verifikasi: `npm run check:gemini`
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=20000
# LOW | MEDIUM | HIGH
GEMINI_THINKING_LEVEL=LOW
# live | mock (mock menampilkan badge "AI simulasi")
AI_MODE=live

OSRM_BASE_URL=https://router.project-osrm.org
# live | mock (mock menampilkan badge "Rute simulasi")
ROUTING_MODE=live
ROUTING_TIMEOUT_MS=4000
MATCH_MAX_ROUTED=5
# Status fasilitas yang lebih tua dari ini dianggap tidak diketahui (bukan READY)
STALE_AFTER_MINUTES=1440
# Masa tunggu PENDING sebelum EXPIRED (10 menit; keputusan T03)
REFERRAL_PENDING_TTL_SECONDS=600

# Pembatas laju per klien (opsional; bawaan 12 analisis/menit dan 10 login/menit)
# ANALYZE_RATE_PER_MINUTE=12
# LOGIN_RATE_PER_MINUTE=10

postgresql://postgres:[YOUR-PASSWORD]@db.uwkgbcmwyijtufgjqnem.supabase.co:5432/postgres

host=db.uwkgbcmwyijtufgjqnem.supabase.co
port=5432
database=postgres
user=postgres