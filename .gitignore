# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.key
*.p12
*.pfx
*.log
*.tmp
*.bak
*.orig
*.rej

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# database lokal PGlite (data simulasi)
/.data/
*.sqlite
*.sqlite3
*.db
*.dump

# akun petugas RS impor (berisi kata sandi; hanya di perangkat lokal)
/akunRumahsakit.md
/data/akun-rumahsakit.local.json

# Konfigurasi asisten dan editor lokal
/.claude/
/.codex/
/.idea/
/.vscode/

# Catatan kerja lokal; dokumentasi publik tersedia di README.md dan docs/
/AGENTS.md
/GOAL.md
/SPEC.md
/TASK.md

# Bahan pengumpulan yang belum final dan hasil pengukuran lokal
/docs/DEVPOST.md
/docs/PITCH-DECK.md
/docs/SMOKE-TEST.md
/docs/hasil-ukur-*.json
